{
  "_comment": "Pterodactyl / Pella-style egg — Node.js Discord bot for SecureAuth 2FA. Set PAPER_API_URL to http://IP:plugin-http-port",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-10-09T00:00:00+00:00",
  "name": "SecureAuth Discord Bot",
  "author": "tienday",
  "description": "Node.js bot for SecureAuth Discord 2FA / link. Env: DISCORD_TOKEN, API_SECRET, PAPER_API_URL (plugin HTTP).",
  "features": ["pid_limit"],
  "docker_images": {
    "Node 20": "ghcr.io/pterodactyl/yolks:nodejs_20",
    "Node 18": "ghcr.io/pterodactyl/yolks:nodejs_18"
  },
  "file_denylist": [],
  "startup": "if [ -f package.json ]; then npm install --omit=dev; fi; node {{MAIN_FILE}}",
  "config": {
    "files": "{}",
    "startup": "{\n    \"done\": \"SecureAuth bot started\"\n}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\nset -e\ncd /mnt/server\nif [ -f package.json ]; then npm install; else echo \"Upload bot source (package.json + index)\"; fi",
      "container": "ghcr.io/pterodactyl/installers:debian",
      "entrypoint": "bash"
    }
  },
  "variables": [
    {
      "name": "Main file",
      "description": "Entry JS/TS file",
      "env_variable": "MAIN_FILE",
      "default_value": "index.js",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:64",
      "field_type": "text"
    },
    {
      "name": "Paper API URL",
      "description": "http://IP:plugin-http-port of SecureAuth plugin (e.g. http://127.0.0.1:20334)",
      "env_variable": "PAPER_API_URL",
      "default_value": "http://127.0.0.1:20334",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:256",
      "field_type": "text"
    },
    {
      "name": "API Secret",
      "description": "Must match discord-bot.api-secret in Paper config.yml",
      "env_variable": "API_SECRET",
      "default_value": "CHANGE_ME_STRONG_SECRET",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:256",
      "field_type": "text"
    }
  ]
}
